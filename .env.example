# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID= # Optional: specific guild ID for fast command sync during development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/dgg_pm

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_SECONDS=5.0
OUTBOX_BATCH_SIZE=10

# API / Health Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Command Sync & Rate-Limit Protection
# When false (default in production), commands are NOT synced automatically on boot to prevent rate-limits/lockouts.
# Defaults to true in development.
SYNC_COMMANDS_ON_STARTUP=true
# Crash-loop backoff delay in seconds if bot startup encounters fatal gateway/sync errors
STARTUP_CRASH_BACKOFF_SECONDS=30.0

